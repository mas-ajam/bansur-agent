#!/usr/bin/env bash
# ============================================================================
# venv-style activation of the Bansur dev environment for an interactive shell.
#
#   source ./activate       (bash / zsh, repo root)
#   source ./activate.fish  (fish)
#   .\activate.ps1          (PowerShell)
#
# Applies the composed pm env (PATH + tool vars) to the CURRENT shell, with
# save/restore: `deactivate` undoes exactly what activation changed.
#
# `bansur` becomes a shell function for this checkout. It runs only while the
# shell is inside this worktree and refuses outside it, so a sibling worktree
# keeps its own command. A prompt prefix names the worktree.
#
# Scripts and other processes do not source this: they run under
# `scripts/run-in-bansur-env`. Both build on scripts/_activation.sh.
#
# Sync through setup before selecting the environment. PM owns freshness;
# activation does not maintain a second dependency stamp. It trusts the
# recorded tool digest instead of re-hashing every entry. `bansur pm
# install` and `bansur update` keep that check.
# ============================================================================
_BANSUR_REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Options: `--test-extras a,b` selects the test environment's runtime extras
# (default: [all]); `--` ends options.
# A bare `source ./activate` inherits the caller's positional parameters.
# Ignore unrelated words so scripts with their own arguments can source it.
_bansur_test_env="--test-environment"
_bansur_expect_extras=""
for _bansur_arg in "$@"; do
    if [ -n "$_bansur_expect_extras" ]; then
        _bansur_test_env="--test-environment=$_bansur_arg"
        _bansur_expect_extras=""
        continue
    fi
    case "$_bansur_arg" in
        --) break ;;
        --test-extras) _bansur_expect_extras=1 ;;
        --test-extras=*) _bansur_test_env="--test-environment=${_bansur_arg#--test-extras=}" ;;
        *) : ;;
    esac
done
if [ -n "$_bansur_expect_extras" ]; then
    printf '%s\n' 'activate: --test-extras needs a comma-separated list' >&2
    unset _bansur_arg _bansur_test_env _bansur_expect_extras
    return 2 2>/dev/null || exit 2
fi
unset _bansur_arg _bansur_expect_extras

# shellcheck source=scripts/_activation.sh
. "$_BANSUR_REPO/scripts/_activation.sh"

if ! bansur_sync "$_BANSUR_REPO" "$_bansur_test_env"; then
    printf '%s\n' 'activate: setup failed; shell environment unchanged' >&2
    unset _bansur_test_env
    return 1 2>/dev/null || exit 1
fi
unset _bansur_test_env

# Guard against double-sourcing: venv activate precedent (re-activating is a
# no-op re-save; we keep it idempotent by deactivating first). Key on the
# function, not the sentinel: child shells inherit __BANSUR_ACTIVATED from an
# activated parent but never the function, and there is nothing to undo there.
if [ "$(type -t deactivate 2>/dev/null)" = "function" ]; then
    deactivate
fi

_bansur_script="$(bansur_compose_env "$_BANSUR_REPO" sh)" || {
    echo "activate: could not compose the environment (see above)" >&2
    unset _bansur_script
    return 1 2>/dev/null || exit 1
}
_bansur_keys="$(printf '%s\n' "$_bansur_script" | sed -n 's/^export \([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' | tr '\n' ' ')"

# --- snapshot what we are about to change (deactivate restores this) ---
# __BANSUR_ACTIVATED is part of the composed env below (it carries the
# installed-state path this environment was built from), so it is snapshotted
# and exported with every other key — no separate assignment here.
__BANSUR_SAVED_PATH="$PATH"
for _bansur_k in $_bansur_keys; do
    eval "__BANSUR_SAVED_$_bansur_k=\"\${$_bansur_k+set}\""
    eval "__BANSUR_PRIOR_$_bansur_k=\${$_bansur_k-__BANSUR_UNSET__}"
done
bansur_apply_env "$_bansur_script"

# This checkout, not whichever `bansur` PATH finds. A function beats PATH, an
# alias, and a hashed command, including the MSIX execution alias.
__BANSUR_WORKTREE="$_BANSUR_REPO"
# The branch names the worktree. A checkout cannot share a branch with another.
__BANSUR_WORKTREE_NAME="$(git -C "$_BANSUR_REPO" rev-parse --abbrev-ref HEAD 2>/dev/null || :)"
if [ -z "$__BANSUR_WORKTREE_NAME" ] || [ "$__BANSUR_WORKTREE_NAME" = HEAD ]; then
    __BANSUR_WORKTREE_NAME="$(basename "$_BANSUR_REPO")"
fi
__BANSUR_SAVED_PS1="${PS1-__BANSUR_UNSET__}"
__BANSUR_SAVED_PROMPT_COMMAND="${PROMPT_COMMAND-__BANSUR_UNSET__}"

_bansur_worktree_here() {
    _bansur_top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1
    [ "$(cd "$_bansur_top" && pwd -P)" = "$(cd "$__BANSUR_WORKTREE" && pwd -P)" ]
}

bansur() {
    _bansur_worktree_here || {
        printf '%s\n' "bansur: $(pwd) is outside $__BANSUR_WORKTREE; refusing (the installed command is hidden while this checkout is active)" >&2
        return 1
    }
    (
        cd "$__BANSUR_WORKTREE" || exit 1
        if [ -n "${PYTHON-}" ]; then
            exec "$PYTHON" bansur "$@"
        elif [ -x .venv/Scripts/python.exe ]; then
            exec .venv/Scripts/python.exe bansur "$@"
        elif [ -x .venv/bin/python ]; then
            exec .venv/bin/python bansur "$@"
        elif [ -x venv/Scripts/python.exe ]; then
            exec venv/Scripts/python.exe bansur "$@"
        elif [ -x venv/bin/python ]; then
            exec venv/bin/python bansur "$@"
        else
            exec python bansur "$@"
        fi
    )
}

_bansur_prompt() {
    if [ "$__BANSUR_SAVED_PS1" = "__BANSUR_UNSET__" ]; then
        _bansur_base_ps1=""
    else
        _bansur_base_ps1="$__BANSUR_SAVED_PS1"
    fi
    if _bansur_worktree_here; then
        PS1="($__BANSUR_WORKTREE_NAME) $_bansur_base_ps1"
    else
        PS1="$_bansur_base_ps1"
    fi
}

if [ -n "${PROMPT_COMMAND-}" ]; then
    PROMPT_COMMAND="_bansur_prompt; ${PROMPT_COMMAND}"
else
    PROMPT_COMMAND=_bansur_prompt
fi
_bansur_prompt

deactivate() {
    export PATH="$__BANSUR_SAVED_PATH"
    for _bansur_k in $__BANSUR_KEY_LIST; do
        eval "_bansur_was=\"\$__BANSUR_SAVED_$_bansur_k\""
        eval "_bansur_old=\"\$__BANSUR_PRIOR_$_bansur_k\""
        if [ "$_bansur_was" != "set" ]; then
            unset "$_bansur_k"
        else
            export "$_bansur_k=$_bansur_old"
        fi
        unset "__BANSUR_SAVED_$_bansur_k" "__BANSUR_PRIOR_$_bansur_k"
    done
    if [ "$__BANSUR_SAVED_PS1" = "__BANSUR_UNSET__" ]; then
        unset PS1
    else
        PS1="$__BANSUR_SAVED_PS1"
    fi
    if [ "$__BANSUR_SAVED_PROMPT_COMMAND" = "__BANSUR_UNSET__" ]; then
        unset PROMPT_COMMAND
    else
        PROMPT_COMMAND="$__BANSUR_SAVED_PROMPT_COMMAND"
    fi
    unset __BANSUR_SAVED_PATH __BANSUR_KEY_LIST __BANSUR_ACTIVATED \
          __BANSUR_WORKTREE __BANSUR_WORKTREE_NAME \
          __BANSUR_SAVED_PS1 __BANSUR_SAVED_PROMPT_COMMAND
    unset -f deactivate bansur _bansur_worktree_here _bansur_prompt
    unset _bansur_k _bansur_was _bansur_old _bansur_top
}

# remember the key list for deactivate (kept out of the loop vars above)
__BANSUR_KEY_LIST="$_bansur_keys"

# The composition library is not part of the user's shell.
unset -f bansur_sync bansur_bootstrap_python bansur_compose_env bansur_apply_env \
         bansur_activation_current bansur_ensure_env
unset _BANSUR_REPO _bansur_script _bansur_keys _bansur_k _bansur_top
